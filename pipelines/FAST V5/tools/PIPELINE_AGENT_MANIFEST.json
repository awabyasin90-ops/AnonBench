{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project_title": "Anonymization Failure Patterns Across Real Drives and CARLA Simulation",
  "version": "2.2.0",
  "last_updated": "2026-11-03",
  "description": "Master AI Agent guide and automated verification registry for 2 Ground-Truth Baselines and 5 Evaluated Anonymization Pipelines (+ 1 Sensor Platform).",
  "evaluation_protocols": {
    "protocol": "End-to-End evaluation under pristine as-shipped default confidence thresholds and native resolutions across 6 environmental conditions.",
    "manual_audit_stage": "Manual human audit conducted on 1,200 images per condition across 6 conditions (7,200 images total) to verify ground-truth bounds and compute accuracy and detection miss rates.",
    "pp4av_human_recognizability_filtering": {
      "reference_paper": "Trinh et al., PP4AV: A Benchmarking Dataset for Privacy-Preserving Autonomous Driving, IEEE/CVF WACV 2023, Section 3, Tables 2 & 3",
      "two_tier_annotation_protocol": {
        "tier_1_base_annotation": "Preserve all contextually visible faces and plates (even 4-5 px) in master dataset with status='Ignore' (or 'Borderline'). Prevents arbitrary data deletion.",
        "tier_2_confirmed_targets": "Primary evaluation targets with status='Confirmed'. Strictly filtered by face_width >= 10 px and plate_height >= 8 px."
      },
      "recognizability_thresholds": {
        "face_width_min_px": 10,
        "face_width_below_10_status": "Ignore (empirical human study shows <7px has 0.0% recognizability, 8-11px is unidentifiable blur)",
        "plate_height_min_px": 8,
        "plate_height_below_8_status": "Ignore (empirical human study shows <5px and 6-7px have 0.0% recognizability)"
      },
      "scale_stratification_size_bins": [
        {
          "bin": "Bin 1: Very Small",
          "range": "< 16 px",
          "distance": "Far distance (20+ meters)",
          "role": "Extreme long-range sensitivity & small-object failure modes"
        },
        {
          "bin": "Bin 2: Small",
          "range": "16-32 px",
          "distance": "Mid-to-far distance (10-20 meters)",
          "role": "Standard urban crosswalk and vehicle tracking distance"
        },
        {
          "bin": "Bin 3: Medium",
          "range": "32-64 px",
          "distance": "Standard driving distance (5-10 meters)",
          "role": "Standard automotive perception operating range"
        },
        {
          "bin": "Bin 4: Large",
          "range": "> 64 px",
          "distance": "Close proximity (< 5 meters)",
          "role": "Safety-critical close encounters, intersections, and ego stops"
        }
      ]
    }
  },
